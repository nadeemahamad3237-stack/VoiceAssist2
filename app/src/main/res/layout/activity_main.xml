<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/night_indigo"
    android:padding="24dp">

    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="@color/off_white"
        android:textSize="28sp"
        android:textStyle="bold"
        android:letterSpacing="0.02"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="32dp" />

    <TextView
        android:id="@+id/accessibilityWarning"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/accessibility_needed"
        android:textColor="@color/muted_grey"
        android:textSize="14sp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/titleText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/enableAccessibilityButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/enable_accessibility"
        android:backgroundTint="@color/saffron"
        android:textColor="@color/night_indigo_dark"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/accessibilityWarning"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageButton
        android:id="@+id/micButton"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:background="@drawable/mic_button_bg"
        android:src="@drawable/ic_mic"
        android:contentDescription="@string/mic_idle"
        android:scaleType="centerInside"
        android:padding="32dp"
        app:layout_constraintTop_toBottomOf="@id/enableAccessibilityButton"
        app:layout_constraintBottom_toTopOf="@id/statusText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.35" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/mic_idle"
        android:textColor="@color/muted_grey"
        android:textSize="16sp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/micButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/alwaysListenSwitch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hamesha suno (&quot;Hey Assistant&quot;)"
        android:textColor="@color/off_white"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/statusText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/heardText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textColor="@color/off_white"
        android:textSize="18sp"
        android:gravity="center"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/alwaysListenSwitch"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/commandsHint"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Kahiye: &quot;home jao&quot;, &quot;wapas jao&quot;, &quot;scroll neeche&quot;, &quot;WhatsApp kholo&quot;, &quot;dabao Send&quot;, &quot;likho hello&quot;, &quot;recent apps&quot;"
        android:textColor="@color/muted_grey"
        android:textSize="13sp"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="24dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
